{
  "name": "dsh-claude-in",
  "version": "0.1.0",
  "description": "让 DeepSeek Harness 打开工作区时自动载入 Claude Code 配置：Skills/Rules/Hooks/Agents 四样资产，固定双位置（工作区自身 .claude + ~/.claude）运行时直读、零写入。Claude Code 兼容层。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.sh",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-hook-protocol": "0.1.0-rc.6",
    "yaml": "^2.9.0"
  },
  "bundledDependencies": [
    "@deepseek-ai/dsh-hook-protocol"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node tests/test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundleDependencies": [
    "@deepseek-ai/dsh-hook-protocol"
  ]
}
