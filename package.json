{
  "name": "dsh-claude-in",
  "version": "0.1.0",
  "description": "让 DeepSeek Harness 打开工作区时自动载入 Claude Code 配置：Skills/Rules/Hooks/Agents 四样资产，固定双位置（工作区自身 .claude + ~/.claude）运行时直读、零写入。Claude Code 兼容层。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "claude-code",
    "cordis"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "yaml": "^2.9.0"
  },
  "bundledDependencies": [
    "@deepseek-ai/dsh-hook-protocol"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "prepare": "npm run build",
    "test": "node tests/test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.2",
    "esbuild": "^0.25.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundleDependencies": [
    "@deepseek-ai/dsh-hook-protocol"
  ]
}
